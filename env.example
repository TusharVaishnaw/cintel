# Copy this file to .env in the project root (same folder as server.py, fetch.py).
# server.py loads .env automatically via python-dotenv on startup.

# Required — extract_annual_report.py (LLM extraction), evaluate.py (DeepEval judge model)
GEMINI_API_KEY=

# Optional — enrich.py (latest_news enrichment). If unset, that enrichment step
# is skipped/degraded rather than failing the pipeline.
NEWSAPI_KEY=
